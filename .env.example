# Copy to .env. Leave OPENAI_API_KEY empty to run lexical-only without the judge and the agents.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o
# Managed Postgres with pgvector (sslmode=require). For the local container overlay these are overridden.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=25060
POSTGRES_DB=
POSTGRES_SSLMODE=require
# API key -> principal. Use long random strings; the key decides the scopes, the caller cannot.
GATEWAY_KEYS={"dev-public": {"agent": "public-agent", "scopes": ["public"]}, "dev-internal": {"agent": "internal-agent", "scopes": ["public", "internal"]}, "dev-finance": {"agent": "finance-agent", "scopes": ["public", "internal", "private"]}}
# Let the demo page choose an access level without a key. Off by default.
DEMO_MODE=false
